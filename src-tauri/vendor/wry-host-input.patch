 /// An id for a webview
 pub type WebViewId<'a> = &'a str;
 
+/// MURMUR PATCH (vendor/README.md): webview ids whose WebView2 controller is created with
+/// `AllowHostInputProcessing`. Set once, before those webviews are created. Windows only;
+/// a no-op elsewhere.
+static HOST_INPUT_PROCESSING_IDS: std::sync::OnceLock<&'static [&'static str]> =
+  std::sync::OnceLock::new();
+
+/// MURMUR PATCH: route the listed webviews' input through the host's message queue
+/// (`ICoreWebView2ControllerOptions4::AllowHostInputProcessing`). Returns `false` when a
+/// list was already set.
+pub fn set_host_input_processing_ids(ids: &'static [&'static str]) -> bool {
+  HOST_INPUT_PROCESSING_IDS.set(ids).is_ok()
+}
+
+#[allow(dead_code)]
+pub(crate) fn host_input_processing_enabled(id: &str) -> bool {
+  HOST_INPUT_PROCESSING_IDS
+    .get()
+    .is_some_and(|ids| ids.contains(&id))
+}
