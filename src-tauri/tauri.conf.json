{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur",
  "version": "0.5.0",
  "identifier": "us.zethr.murmur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "create": false,
        "title": "Murmur Settings",
        "url": "index.html",
        "width": 1000,
        "height": 780,
        "visible": false,
        "minWidth": 760,
        "minHeight": 560
      },
      {
        "label": "overlay",
        "create": false,
        "title": "Murmur Overlay",
        "url": "index.html?window=overlay",
        "width": 608,
        "height": 160,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "default",
        "overlay-drag"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private local dictation",
    "linux": {
      "deb": {
        "depends": [
          "xdotool",
          "x11-utils",
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2t64 | libasound2",
          "libx11-6",
          "libxkbcommon0",
          "libdbus-1-3"
        ]
      }
    },
    "licenseFile": "../LICENSE"
  }
}
